#Prod
server {
    listen 80;
    listen [::]:80;

    root /home/falcon/ezxport/prod/frontend/current;
    index index.html index.htm index.nginx-debian.html;

    server_name app.ezxport.com;

    location / {
            try_files $uri /index.html;
    }

}

server {
    listen 80;
    listen [::]:80;
    server_name api.ezxport.com;

    location /
    {
        proxy_pass http://127.0.0.1:1043;
    }
}